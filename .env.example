# Copy to .env (git-ignored). Used by the local dev server, `pnpm run deploy`
# and `pnpm run secret:put`. In CI, set the same names as environment variables.

# Your Spotify developer app (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
# Local development reads it from here; on AWS it lives in SSM Parameter Store
# (upload it with `pnpm run secret:put`).
SPOTIFY_CLIENT_SECRET=

# Optional deployment settings (alternatively in packages/infra/cdk.json)
# SPOTIFY_CLIENT_SECRET_PARAMETER=/podcast-cockpit/spotify-client-secret
# DOMAIN_NAME=podcasts.example.com
# HOSTED_ZONE_NAME=example.com
# CERTIFICATE_ARN=
# STACK_NAME=PodcastCockpit

# Copy to .env (git-ignored). Loaded by the dev server, `cdk` and
# `pnpm run secret:put` via Node's --env-file-if-exists; real environment
# variables win. In CI, set the same names as environment variables.

# Your Spotify developer app (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
# Used by the local dev server, and by `pnpm run secret:put` to store it in
# the stack's SSM parameter after deploying. Never passed to CDK.
SPOTIFY_CLIENT_SECRET=

# AWS profile for cdk (bootstrap/deploy) and `pnpm run secret:put`. The cdk scripts
# load this file before the CDK CLI resolves credentials; a shell AWS_PROFILE wins.
# Log in first, e.g. `aws sso login --profile <name>`.
# AWS_PROFILE=

# Optional deployment settings (alternatively in packages/infra/cdk.json)
# DOMAIN_NAME=podcasts.example.com
# HOSTED_ZONE_NAME=example.com
# CERTIFICATE_ARN=
# Stage (default dev): part of the stack names (PodcastCockpit-dev) and the SSM path
# STAGE=dev
# Name prefix of the stacks (default PodcastCockpit)
# STACK_NAME=PodcastCockpit

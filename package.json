{
  "name": "spotify-podcast-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Personal podcast cockpit in front of Spotify",
  "scripts": {
    "dev": "pnpm --parallel --filter @podcast/backend --filter @podcast/frontend dev",
    "dev:demo": "pnpm --parallel --filter @podcast/backend --filter @podcast/frontend dev:demo",
    "dev:backend": "pnpm --filter @podcast/backend dev",
    "dev:frontend": "pnpm --filter @podcast/frontend dev",
    "build": "pnpm --filter @podcast/frontend build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "synth": "pnpm build && pnpm --filter @podcast/infra run synth",
    "deploy": "pnpm build && pnpm --filter @podcast/infra run deploy",
    "secret:put": "pnpm --filter @podcast/infra run secret:put",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.9.1"
}
